DATABASE_URL=postgres://localhost/marketplace_dev

# Los emails que pueden entrar al editor NO van acá (este archivo está en
# git). Van en `.env.local`, que git ignora, separados por comas:
#   ALLOWED_EMAILS=vos@correo.com,otra@correo.com

# Carpeta donde se guardan las fotos que suben los dueños (Mis fotos).
# MEDIA_DIR=media

# Mis fotos en Cloudflare R2: las claves son secretas, así que NO van acá
# (este archivo está en git). Van en `.env.local`, que git ignora:
#   R2_ACCOUNT_ID=...
#   R2_BUCKET=...
#   R2_ACCESS_KEY_ID=...
#   R2_SECRET_ACCESS_KEY=...
