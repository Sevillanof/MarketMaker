DATABASE_URL=postgres://localhost/marketplace_dev

# Los emails que pueden entrar al editor NO van acá (este archivo está en
# git). Van en `.env.local`, que git ignora, separados por comas:
#   ALLOWED_EMAILS=vos@correo.com,otra@correo.com
# Para que cualquiera pueda crear su cuenta (sin lista), poné en `.env.local`:
#   REGISTRO_ABIERTO=true
# El administrador (ve la Whitelist y el panel de uso):
#   ADMIN_EMAILS=vos@correo.com

# Carpeta donde se guardan las fotos que suben los dueños (Mis fotos).
# MEDIA_DIR=media

# Mis fotos en Cloudflare R2: las claves son secretas, así que NO van acá
# (este archivo está en git). Van en `.env.local`, que git ignora:
#   R2_ACCOUNT_ID=...
#   R2_BUCKET=...
#   R2_ACCESS_KEY_ID=...
#   R2_SECRET_ACCESS_KEY=...

# Cobrar con Mercado Pago: la aplicación de MarketMaker en
# mercadopago.com.ar/developers (tipo Checkout Pro). Las claves son secretas:
# van en `.env.local`, que git ignora:
#   MP_CLIENT_ID=...
#   MP_CLIENT_SECRET=...
# La "URL de redireccionamiento" de la aplicación tiene que ser esta (o la
# que pongas en MP_REDIRECT_URL):
#   http://localhost:3000/mp/vincular
# Opcional, para que Mercado Pago avise los pagos aunque el comprador no
# vuelva a la tienda: la dirección https de un túnel (cloudflared) a este
# servidor. Sin ella, el pago se confirma cuando el comprador vuelve.
#   MP_PUBLIC_URL=https://....trycloudflare.com
# Opcional: la "clave secreta" de Webhooks de la aplicación. Con ella se
# comprueba la firma de cada aviso de pago y se anota el resultado
# (MP_SANDBOX_WEBHOOK_SECRET para la aplicación de prueba). Con
# MP_WEBHOOK_STRICT=1 además se descartan los que no vienen firmados:
#   MP_WEBHOOK_SECRET=...
#   MP_WEBHOOK_STRICT=1
# Opcional, tiendas de prueba con una aplicación de una cuenta de prueba
# "integradora" (Mercado Pago no deja pagar mezclando cuentas reales y de prueba):
#   MP_SANDBOX_STORES=pruebas
#   MP_SANDBOX_CLIENT_ID=...
#   MP_SANDBOX_CLIENT_SECRET=...

# Emails (comprobante al comprador, aviso de venta al dueño y códigos para
# entrar) con Resend. La clave es secreta: va en `.env.local`:
#   RESEND_API_KEY=re_...
#   EMAIL_FROM="Mi tienda <ventas@tudominio.com>"   # con comillas (tiene espacios); hace falta dominio verificado en Resend
# Sin dominio verificado, Resend solo entrega a tu propio email (el de tu
# cuenta de Resend), desde onboarding@resend.dev. Sin RESEND_API_KEY, los
# emails se escriben en la terminal.
# Dirección de la plataforma para los enlaces de los emails:
#   APP_URL=http://localhost:3000
