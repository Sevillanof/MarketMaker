# Instala sola la última versión de main compilada por GitHub (lo dispara
# marketmaker-release.timer cada minuto). Si no hay nada nuevo, no hace nada.
# Si una versión nueva no responde, vuelve a la anterior y no la reintenta.
[Unit]
Description=MarketMaker: instalar la última versión de main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marketmaker
Environment=AUTO=1
# Trae la última copia de los scripts de deploy/ (si falla, sigue igual).
ExecStartPre=-/usr/bin/git -C /opt/marketmaker/src pull -q --ff-only origin main
ExecStart=/opt/marketmaker/src/deploy/release.sh
