# MarketMaker en la VPS: Caddy atiende https en 80/443 y le pasa todo a la
# app, que escucha solo en 127.0.0.1:3000. Los certificados de cada tienda
# (`ana.<plataforma>`) se piden la primera vez que alguien entra, y solo si
# la app dice que esa dirección existe (`/tls-ok`).
# Si Tailscale ya usa el 443 en su propia IP, Caddy tiene que escuchar solo
# en la IP pública (setup.sh la escribe acá al instalar).
#
# Cloudflare (nube naranja) va adelante de todo mkr.com.ar. Caddy confía en
# sus IPs (`trusted_proxies`, lista de cloudflare.com/ips-v4 e ips-v6:
# revisala de vez en cuando) y toma la IP real del visitante de
# `CF-Connecting-IP`; si el pedido NO viene de Cloudflare esa cabecera se
# ignora y la IP real es la del que se conecta (no se puede falsificar).
# La app lee el ÚLTIMO valor de `X-Forwarded-For` (limits::client_ip), así
# que `header_up` lo reemplaza por esa IP real.
{
	default_bind {$PUBLIC_IP:0.0.0.0}
	on_demand_tls {
		ask http://127.0.0.1:3000/tls-ok
	}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}
